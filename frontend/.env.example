# PUBLIC Auth0 configuration (these are identifiers, not secrets).
# Copy this file to .env.local and replace values from Auth0 Dashboard.
EXPO_PUBLIC_AUTH0_DOMAIN=dev-YOUR-TENANT.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=YOUR_NATIVE_APPLICATION_CLIENT_ID
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.kindredlink.example
# For testing against the real backend (optional):
EXPO_PUBLIC_USE_MOCKS=0
# EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:8080
